"VertexLitGeneric"
{
	"$bumpmap" "Models/hecu/humangrunt_normal"
	//"$envmap" "env_cubemap"
	"$normalmapalphaenvmapmask" 1
	"$envmapcontrast" 1
	"$surfaceprop" "flesh"

	"$selfillum" 1
	// Use separate self-illum mask on Pre DX9 hardware
	">=dx90_20b"
	{
		"$baseTexture" 		"Models/hecu/humangrunt_sheet"
		"$selfillummask" 	"Models/hecu/humangrunt_sheet_l"
	}

	// Use redundant self-illum in base alpha on Pre DX9 hardware
	"<dx90_20b"
	{
		"$baseTexture" 	"Models/hecu/humangrunt_sheet"
	}

// -- From here down is new stuff which will only be applied if $phong is set to 1 --
	"$phong" "1"
	"$phongexponent" "10"
	"$phongboost"	"1"
	"$phongfresnelranges"	"[0.25 0.5 1]"
}