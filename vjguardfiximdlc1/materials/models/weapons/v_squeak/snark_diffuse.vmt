//"EDITOR_SHADER"
"VertexLitGeneric"
{
	"$selfillum" 1

	// Use separate self-illum mask on Pre DX9 hardware
	">=dx90_20b"
	{
		"$baseTexture" 		"models/weapons/v_squeak/snark_diffuse"
		"$selfillummask" 	"models/weapons/v_squeak/snark_diffuse_l"
	}

	// Use redundant self-illum in base alpha on Pre DX9 hardware
	"<dx90_20b"
	{
		"$baseTexture" 	"models/weapons/v_squeak/snark_diffuse"
	}

	"$halflambert" 1
}
